,"fix":{"range":[261,279],"text":""},"desc":"Remove unused variable 'setNotifications'."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState } from 'react';\r\nimport './HeaderEmpresas.css';\r\nimport { Search, Bell, User } from 'lucide-react';\r\n\r\nfunction HeaderEmpresas({ onSearch, isSidebarOpen }) {\r\n  const [searchValue, setSearchValue] = useState('');\r\n  const [notifications, setNotifications] = useState([\r\n    { id: 1, message: 'Nueva postulaci├│n de Juan P├®rez', time: '2 min' },\r\n    { id: 2, message: 'Entrevista programada para Mar├¡a Rodr├¡guez', time: '1 hora' },\r\n  ]);\r\n  const [showNotifications, setShowNotifications] = useState(false);\r\n\r\n  const handleSearch = (e) => {\r\n    setSearchValue(e.target.value);\r\n    if (onSearch) {\r\n      onSearch(e.target.value);\r\n    }\r\n  };\r\n\r\n  return (\r\n    <header className={`header-empresas ${!isSidebarOpen ? 'sidebar-closed' : ''}`}>\r\n      <div className=\"header-content\">\r\n        {/* Logo y T├¡tulo */}\r\n        <div className=\"header-brand\">\r\n          <div className=\"brand-logo\">\r\n            <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\r\n              <path d=\"M12 2L2 7V12C2 18.627 7.373 24 12 24C16.627 24 22 18.627 22 12V7L12 2Z\"\r\n                stroke=\"#1a2d4d\" strokeWidth=\"1.5\" fill=\"none\" />\r\n            </svg>\r\n          </div>\r\n          <div className=\"brand-text\">\r\n            <h1>Bolsa de Empleo</h1>\r\n            <p>La Lima</p>\r\n          </div>\r\n        </div>\r\n\r\n        {/* Buscador */}\r\n        <div className=\"header-search\">\r\n          <Search className=\"search-icon\" size={18} />\r\n          <input\r\n            type=\"text\"\r\n            placeholder=\"Buscar candidatos...\"\r\n            value={searchValue}\r\n            onChange={handleSearch}\r\n            className=\"search-input\"\r\n          />\r\n        </div>\r\n\r\n        {/* Acciones */}\r\n        <div className=\"header-actions\">\r\n          {/* Notificaciones */}\r\n          <div className=\"notification-container\">\r\n            <button\r\n              className=\"notification-btn\"\r\n              onClick={() => setShowNotifications(!showNotifications)}\r\n            >\r\n              <Bell size={20} />\r\n              <span className=\"notification-badge\">{notifications.length}</span>\r\n            </button>\r\n\r\n            {showNotifications && (\r\n              <div className=\"notification-dropdown\">\r\n                <div className=\"notification-header\">\r\n                  <h3>Notificaciones</h3>\r\n                </div>\r\n                <div className=\"notification-list\">\r\n                  {notifications.length > 0 ? (\r\n                    notifications.map((notif) => (\r\n                      <div key={notif.id} className=\"notification-item\">\r\n                        <p className=\"notif-message\">{notif.message}</p>\r\n                        <p className=\"notif-time\">{notif.time}</p>\r\n                      </div>\r\n                    ))\r\n                  ) : (\r\n                    <p className=\"no-notifications\">No hay notificaciones</p>\r\n                  )}\r\n                </div>\r\n              </div>\r\n            )}\r\n          </div>\r\n\r\n          {/* Perfil Usuario */}\r\n          <button className=\"profile-btn\">\r\n            <User size={20} />\r\n          </button>\r\n        </div>\r\n      </div>\r\n    </header>\r\n  );\r\n}\r\n\r\nexport default HeaderEmpresas;","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\DELLG\\OneDrive\\Desktop\\Proyecto\\Hackathon2026\\frontend\\src\\components\\Empresas\\MetricasCard\\MetricasCard.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\DELLG\\OneDrive\\Desktop\\Proyecto\\Hackathon2026\\frontend\\src\\components\\Empresas\\MisOfertas\\MisOfertas.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\DELLG\\OneDrive\\Desktop\\Proyecto\\Hackathon2026\\frontend\\src\\components\\Empresas\\ModalContratado\\ModalContratado.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\DELLG\\OneDrive\\Desktop\\Proyecto\\Hackathon2026\\frontend\\src\\components\\Empresas\\ModalEtiquetas\\ModalEtiquetas.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\DELLG\\OneDrive\\Desktop\\Proyecto\\Hackathon2026\\frontend\\src\\components\\Empresas\\PerfilEmpresa\\PerfilEmpresa.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\DELLG\\OneDrive\\Desktop\\Proyecto\\Hackathon2026\\frontend\\src\\components\\Empresas\\SidebarEmpresas\\SidebarEmpresas.jsx","messages":[{"ruleId":"no-unused-vars","severity":2,"message":"'useState' is defined but never used. Allowed unused vars must match /^[A-Z_]/u.","line":1,"column":17,"nodeType":"Identifier","messageId":"unusedVar","endLine":1,"endColumn":25,"suggestions":[{"messageId":"removeVar","data":{"varName":"useState"},"fix":{"range":[12,26],"text":""},"desc":"Remove unused variable 'useState'."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState } from 'react';\r\nimport './SidebarEmpresas.css';\r\nimport { Menu, X, Home, Briefcase, Users, User, Settings, LogOut } from 'lucide-react';\r\n\r\nfunction SidebarEmpresas({ activeSection, setActiveSection, isOpen, setIsOpen }) {\r\n  const toggleSidebar = () => {\r\n    setIsOpen(!isOpen);\r\n  };\r\n\r\n  const menuItems = [\r\n    { id: 'dashboard', label: 'Panel de Control', icon: Home },\r\n    { id: 'ofertas', label: 'Mis Ofertas', icon: Briefcase },\r\n    { id: 'candidatos', label: 'Candidatos', icon: Users },\r\n    { id: 'perfil', label: 'Perfil de Empresa', icon: User },\r\n    { id: 'configuracion', label: 'Configuraci├│n', icon: Settings },\r\n  ];\r\n\r\n  return (\r\n    <div className={`sidebar-container ${isOpen ? 'open' : 'closed'}`}>\r\n      <aside className={`sidebar ${isOpen ? 'open' : 'closed'}`}>\r\n        {/* Header del Sidebar */}\r\n        <div className=\"sidebar-header\">\r\n          <div className=\"sidebar-brand\">\r\n            <div className=\"brand-avatar\">N</div>\r\n            <div className={`brand-info ${!isOpen ? 'hidden' : ''}`}>\r\n              <h3>Nextern Costa Rica</h3>\r\n              <p>Dispositivos M├®dicos</p>\r\n            </div>\r\n          </div>\r\n          <button className=\"toggle-btn\" onClick={toggleSidebar}>\r\n            {isOpen ? <X size={20} /> : <Menu size={20} />}\r\n          </button>\r\n        </div>\r\n\r\n        {/* Men├║ Principal */}\r\n        <nav className=\"sidebar-menu\">\r\n          {menuItems.map((item) => {\r\n            const Icon = item.icon;\r\n            return (\r\n              <button\r\n                key={item.id}\r\n                className={`menu-item ${activeSection === item.id ? 'active' : ''}`}\r\n                onClick={() => setActiveSection(item.id)}\r\n                title={!isOpen ? item.label : ''}\r\n              >\r\n                <Icon size={20} className=\"menu-icon\" />\r\n                {isOpen && <span className=\"menu-label\">{item.label}</span>}\r\n              </button>\r\n            );\r\n          })}\r\n        </nav>\r\n\r\n        {/* Logout */}\r\n        <div className=\"sidebar-footer\">\r\n          <button className=\"logout-btn\">\r\n            <LogOut size={18} />\r\n            {isOpen && <span>Cerrar Sesi├│n</span>}\r\n          </button>\r\n        </div>\r\n      </aside>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default SidebarEmpresas;","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\DELLG\\OneDrive\\Desktop\\Proyecto\\Hackathon2026\\frontend\\src\\components\\Empresas\\TablaPostulaciones\\TablaPostulaciones.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\DELLG\\OneDrive\\Desktop\\Proyecto\\Hackathon2026\\frontend\\src\\components\\InstitutoFormacion\\InstitutoFormacion.jsx","messages":[{"ruleId":"react-hooks/immutability","severity":2,"message":"Error: Cannot access variable before it is declared\n\n`fetchStudents` is accessed before it is declared, which prevents the earlier access from updating when this value changes over time.\n\n  21 |   // ­ƒöÑ SOLO se ejecuta una vez\n  22 |   useEffect(() => {\n> 23 |     fetchStudents();\n     |     ^^^^^^^^^^^^^ `fetchStudents` accessed before it is declared\n  24 |   }, []);\n  25 |\n  26 |   const fetchStudents = async () => {\n\n  24 |   }, []);\n  25 |\n> 26 |   const fetchStudents = async () => {\n     |   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 27 |     const mock = [\n     | ^^^^^^^^^^^^^^^^^^\n> 28 |       {\n     ÔÇª\n     | ^^^^^^^^^^^^^^^^^^\n> 39 |     setStudents(mock);\n     | ^^^^^^^^^^^^^^^^^^\n> 40 |   };\n     | ^^^^^ `fetchStudents` is declared here\n  41 |\n  42 |   // ­ƒöÑ ORDEN DIN├üMICO (NO sobrescribe estado)\n  43 |   const sortedStudents = [...students].sort((a, b) =>","line":23,"column":5,"nodeType":null,"endLine":23,"endColumn":18},{"ruleId":"react-hooks/purity","severity":2,"message":"Error: Cannot call impure function during render\n\n`Date.now` is an impure function. Calling an impure function can produce unstable results that update unpredictably when the component happens to re-render. (https://react.dev/reference/rules/components-and-hooks-must-be-pure#components-and-hooks-must-be-idempotent).\n\n  122 |   const handleInvite = (user) => {\n  123 |     const newStudent = {\n> 124 |       id: Date.now(),\n      |           ^^^^^^^^^^ Cannot call impure function\n  125 |       image_url: \"https://i.pravatar.cc/50\",\n  126 |       name: user.name,\n  127 |       last_name: user.last_name,","line":124,"column":11,"nodeType":null,"endLine":124,"endColumn":21}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useEffect, useState } from \"react\";\r\nimport Swal from \"sweetalert2\";\r\nimport \"./InstitutoFormacion.css\";\r\nimport { Pencil, Trash2 } from \"lucide-react\";\r\n\r\nconst InstitutoFormacion = () => {\r\n  const [students, setStudents] = useState([]);\r\n  const [filter, setFilter] = useState(\"desc\");\r\n  const [showModal, setShowModal] = useState(false);\r\n  const [search, setSearch] = useState(\"\");\r\n  const [searchResults, setSearchResults] = useState([]);\r\n\r\n  const [newUser, setNewUser] = useState({\r\n    image_url: \"\",\r\n    name: \"\",\r\n    last_name: \"\",\r\n    email: \"\",\r\n    phone: \"\",\r\n  });\r\n\r\n  // ­ƒöÑ SOLO se ejecuta una vez\r\n  useEffect(() => {\r\n    fetchStudents();\r\n  }, []);\r\n\r\n  const fetchStudents = async () => {\r\n    const mock = [\r\n      {\r\n        id: 1,\r\n        image_url: \"https://i.pravatar.cc/50\",\r\n        name: \"Juan\",\r\n        last_name: \"P├®rez\",\r\n        email: \"juan@email.com\",\r\n        phone: \"8888-8888\",\r\n        created_at: \"2026-03-01\",\r\n      },\r\n    ];\r\n\r\n    setStudents(mock);\r\n  };\r\n\r\n  // ­ƒöÑ ORDEN DIN├üMICO (NO sobrescribe estado)\r\n  const sortedStudents = [...students].sort((a, b) =>\r\n    filter === \"desc\"\r\n      ? new Date(b.created_at) - new Date(a.created_at)\r\n      : new Date(a.created_at) - new Date(b.created_at)\r\n  );\r\n\r\n  // ÔØî Quitar estudiante\r\n  const handleRemove = (id) => {\r\n    Swal.fire({\r\n      title: \"┬┐Quitar estudiante?\",\r\n      text: \"La relaci├│n ser├í desactivada.\",\r\n      icon: \"warning\",\r\n      showCancelButton: true,\r\n      confirmButtonText: \"S├¡, quitar\",\r\n      cancelButtonText: \"Cancelar\",\r\n    }).then((result) => {\r\n      if (result.isConfirmed) {\r\n        setStudents((prev) => prev.filter((s) => s.id !== id));\r\n        Swal.fire(\"Desactivado\", \"Relaci├│n eliminada correctamente\", \"success\");\r\n      }\r\n    });\r\n  };\r\n\r\n  // Ô£Å´©Å Editar estudiante (simulaci├│n)\r\n    const handleEdit = (student) => {\r\n    Swal.fire({\r\n        title: \"Editar usuario\",\r\n        html: `\r\n        <input id=\"swal-name\" class=\"swal2-input\" placeholder=\"Nombre\" value=\"${student.name}\">\r\n        <input id=\"swal-lastname\" class=\"swal2-input\" placeholder=\"Apellido\" value=\"${student.last_name}\">\r\n        <input id=\"swal-email\" class=\"swal2-input\" placeholder=\"Correo\" value=\"${student.email}\">\r\n        <input id=\"swal-phone\" class=\"swal2-input\" placeholder=\"Tel├®fono\" value=\"${student.phone}\">\r\n        <input id=\"swal-image\" class=\"swal2-input\" placeholder=\"URL Imagen\" value=\"${student.image_url}\">\r\n        `,\r\n        focusConfirm: false,\r\n        showCancelButton: true,\r\n        confirmButtonText: \"Guardar cambios\",\r\n        cancelButtonText: \"Cancelar\",\r\n        preConfirm: () => {\r\n        return {\r\n            name: document.getElementById(\"swal-name\").value,\r\n            last_name: document.getElementById(\"swal-lastname\").value,\r\n            email: document.getElementById(\"swal-email\").value,\r\n            phone: document.getElementById(\"swal-phone\").value,\r\n            image_url: document.getElementById(\"swal-image\").value,\r\n        };\r\n        },\r\n    }).then((result) => {\r\n        if (result.isConfirmed) {\r\n        setStudents((prev) =>\r\n            prev.map((s) =>\r\n            s.id === student.id\r\n                ? { ...s, ...result.value }\r\n                : s\r\n            )\r\n        );\r\n\r\n        Swal.fire(\"Actualizado\", \"Los datos fueron modificados\", \"success\");\r\n        }\r\n    });\r\n    };\r\n\r\n  // ­ƒöì Buscar usuarios (simulaci├│n)\r\n  const handleSearch = () => {\r\n    if (!search) return;\r\n\r\n    const mockResults = [\r\n      {\r\n        id: 99,\r\n        name: \"Carlos\",\r\n        last_name: \"Ram├¡rez\",\r\n        email: \"carlos@email.com\",\r\n      },\r\n    ];\r\n\r\n    setSearchResults(mockResults);\r\n  };\r\n\r\n  // ­ƒô® Invitar y agregar\r\n  const handleInvite = (user) => {\r\n    const newStudent = {\r\n      id: Date.now(),\r\n      image_url: \"https://i.pravatar.cc/50\",\r\n      name: user.name,\r\n      last_name: user.last_name,\r\n      email: user.email,\r\n      phone: \"No registrado\",\r\n      created_at: new Date().toISOString().split(\"T\")[0],\r\n    };\r\n\r\n    setStudents((prev) => [newStudent, ...prev]);\r\n\r\n    Swal.fire({\r\n      icon: \"success\",\r\n      title: \"Usuario agregado\",\r\n      text: `${user.email} ahora pertenece al instituto`,\r\n    });\r\n  };\r\n\r\n  // ­ƒôè Subir Excel (simulaci├│n)\r\n  const handleExcel = (e) => {\r\n    const file = e.target.files[0];\r\n    if (!file) return;\r\n\r\n    if (!file.name.endsWith(\".xlsx\") && !file.name.endsWith(\".csv\")) {\r\n      Swal.fire({\r\n        icon: \"error\",\r\n        title: \"Formato incorrecto\",\r\n        text: \"Debe subir un archivo Excel v├ílido (.xlsx o .csv)\",\r\n      });\r\n      return;\r\n    }\r\n\r\n    Swal.fire({\r\n      icon: \"success\",\r\n      title: \"Archivo cargado\",\r\n      text: \"Simulaci├│n: usuarios agregados localmente\",\r\n    });\r\n  };\r\n\r\n  // ­ƒåò Crear usuario manual\r\n  const handleCreateUser = () => {\r\n    if (!newUser.name || !newUser.last_name || !newUser.email) {\r\n      Swal.fire(\"Error\", \"Nombre, apellido y correo son obligatorios\", \"error\");\r\n      return;\r\n    }\r\n\r\n    const createdUser = {\r\n      id: Date.now(),\r\n      image_url: newUser.image_url || \"https://i.pravatar.cc/50\",\r\n      name: newUser.name,\r\n      last_name: newUser.last_name,\r\n      email: newUser.email,\r\n      phone: newUser.phone || \"No registrado\",\r\n      created_at: new Date().toISOString().split(\"T\")[0],\r\n    };\r\n\r\n    setStudents((prev) => [createdUser, ...prev]);\r\n\r\n    Swal.fire(\"Creado\", \"Usuario agregado correctamente\", \"success\");\r\n\r\n    setNewUser({\r\n      image_url: \"\",\r\n      name: \"\",\r\n      last_name: \"\",\r\n      email: \"\",\r\n      phone: \"\",\r\n    });\r\n  };\r\n\r\n  return (\r\n    <div className=\"students-container\">\r\n      <div className=\"students-header\">\r\n        <h2>Usuarios</h2>\r\n\r\n        <div className=\"students-actions\">\r\n          <select onChange={(e) => setFilter(e.target.value)}>\r\n            <option value=\"desc\">M├ís nuevos</option>\r\n            <option value=\"asc\">M├ís viejos</option>\r\n          </select>\r\n\r\n          <button className=\"add-btn\" onClick={() => setShowModal(true)}>\r\n            Agregar Usuarios\r\n          </button>\r\n        </div>\r\n      </div>\r\n\r\n      <table className=\"students-table\">\r\n        <thead>\r\n          <tr>\r\n            <th>Imagen</th>\r\n            <th>Nombre</th>\r\n            <th>Email</th>\r\n            <th>Tel├®fono</th>\r\n            <th>Fecha</th>\r\n            <th>Acci├│n</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody>\r\n          {sortedStudents.map((s) => (\r\n            <tr key={s.id}>\r\n              <td>\r\n                <img src={s.image_url} alt=\"profile\" />\r\n              </td>\r\n              <td>{s.name} {s.last_name}</td>\r\n              <td>{s.email}</td>\r\n              <td>{s.phone}</td>\r\n              <td>{s.created_at}</td>\r\n                <td className=\"actions-cell\">\r\n                <button\r\n                    className=\"edit-btn\"\r\n                    onClick={() => handleEdit(s)}\r\n                >\r\n                    <Pencil size={16} />\r\n                    Editar\r\n                </button>\r\n\r\n                <button\r\n                    className=\"remove-btn\"\r\n                    onClick={() => handleRemove(s.id)}\r\n                >\r\n                    <Trash2 size={16} />\r\n                    Eliminar\r\n                </button>\r\n                </td>\r\n            </tr>\r\n          ))}\r\n        </tbody>\r\n      </table>\r\n\r\n      {/* ­ƒƒª MODAL */}\r\n      {showModal && (\r\n        <div className=\"modal-overlay\">\r\n          <div className=\"modal\">\r\n            <h3>Agregar Usuarios</h3>\r\n\r\n            <div className=\"manual-section\">\r\n              <h4>Crear Usuario Manualmente</h4>\r\n\r\n              <input\r\n                type=\"text\"\r\n                placeholder=\"URL Imagen\"\r\n                value={newUser.image_url}\r\n                onChange={(e) =>\r\n                  setNewUser({ ...newUser, image_url: e.target.value })\r\n                }\r\n              />\r\n              <input\r\n                type=\"text\"\r\n                placeholder=\"Nombre\"\r\n                value={newUser.name}\r\n                onChange={(e) =>\r\n                  setNewUser({ ...newUser, name: e.target.value })\r\n                }\r\n              />\r\n              <input\r\n                type=\"text\"\r\n                placeholder=\"Apellido\"\r\n                value={newUser.last_name}\r\n                onChange={(e) =>\r\n                  setNewUser({ ...newUser, last_name: e.target.value })\r\n                }\r\n              />\r\n              <input\r\n                type=\"email\"\r\n                placeholder=\"Correo\"\r\n                value={newUser.email}\r\n                onChange={(e) =>\r\n                  setNewUser({ ...newUser, email: e.target.value })\r\n                }\r\n              />\r\n              <input\r\n                type=\"text\"\r\n                placeholder=\"Tel├®fono\"\r\n                value={newUser.phone}\r\n                onChange={(e) =>\r\n                  setNewUser({ ...newUser, phone: e.target.value })\r\n                }\r\n              />\r\n\r\n              <button onClick={handleCreateUser}>Crear Usuario</button>\r\n            </div>\r\n\r\n            <hr />\r\n\r\n            <div className=\"invite-section\">\r\n              <h4>Invitar Usuario</h4>\r\n              <div className=\"search-box\">\r\n                <input\r\n                  type=\"text\"\r\n                  placeholder=\"Buscar por nombre o correo\"\r\n                  value={search}\r\n                  onChange={(e) => setSearch(e.target.value)}\r\n                />\r\n                <button onClick={handleSearch}>Buscar</button>\r\n              </div>\r\n\r\n              {searchResults.map((user) => (\r\n                <div key={user.id} className=\"search-result\">\r\n                  <span>\r\n                    {user.name} {user.last_name} - {user.email}\r\n                  </span>\r\n                  <button onClick={() => handleInvite(user)}>\r\n                    Agregar\r\n                  </button>\r\n                </div>\r\n              ))}\r\n            </div>\r\n\r\n            <hr />\r\n\r\n            <div className=\"excel-section\">\r\n              <h4>Registrar mediante Excel</h4>\r\n              <input type=\"file\" onChange={handleExcel} />\r\n              <p className=\"excel-info\">\r\n                El archivo debe contener: Nombre, Apellido y Correo\r\n              </p>\r\n            </div>\r\n\r\n            <button className=\"close-btn\" onClick={() => setShowModal(false)}>\r\n              Cerrar\r\n            </button>\r\n          </div>\r\n        </div>\r\n      )}\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default InstitutoFormacion;","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\DELLG\\OneDrive\\Desktop\\Proyecto\\Hackathon2026\\frontend\\src\\components\\LandingPage\\Footer.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\DELLG\\OneDrive\\Desktop\\Proyecto\\Hackathon2026\\frontend\\src\\components\\LandingPage\\Header.jsx","messages":[{"ruleId":null,"nodeType":null,"fatal":true,"severity":2,"message":"Parsing error: Identifier 'Navbar' has already been declared","line":3,"column":8}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":1,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from 'react';\r\nimport Navbar from '../Navbar/Navbar';\r\nimport Navbar from '../Navbar/Navbar'; // Aseg├║rate de que la ruta sea correcta\r\n// import './Header.css'; // Estilos del header\r\nconst Header = ({ children, backgroundImage }) => {\r\n  return (\r\n    <header\r\n      className='header-container'\r\n      style={{\r\n        backgroundImage: backgroundImage ? `url(${backgroundImage})` : 'none',\r\n      }}\r\n    >\r\n      {/* Navbar */}\r\n      <Navbar />\r\n\r\n      {/* Contenido opcional dentro del header */}\r\n      {children && <div className='header-content'>{children}</div>}\r\n    </header>\r\n  );\r\n};\r\n\r\nexport default Header;\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\DELLG\\OneDrive\\Desktop\\Proyecto\\Hackathon2026\\frontend\\src\\components\\LandingPage\\LandingPage.jsx","messages":[{"ruleId":"no-unused-vars","severity":2,"message":"'motion' is defined but neve